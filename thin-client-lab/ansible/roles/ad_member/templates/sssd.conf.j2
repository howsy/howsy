# {{ ansible_managed }}
[sssd]
domains = {{ ad_domain }}
config_file_version = 2
services = nss, pam

[domain/{{ ad_domain }}]
id_provider = ad
auth_provider = ad
chpass_provider = ad
ad_domain = {{ ad_domain }}
krb5_realm = {{ ad_realm }}
realmd_tags = manages-system joined-with-adcli
{% if ad_server %}
ad_server = {{ ad_server }}
{% endif %}
# realm deny --all / realm permit -g
access_provider = simple
simple_allow_groups = {{ ad_allowed_groups | join(', ') }}
# Agents type their Windows username without the domain
use_fully_qualified_names = False
fallback_homedir = /home/%u
default_shell = /bin/bash
ldap_id_mapping = True
# Allow login when the DC is unreachable (e.g. home endpoint before the VPN is up)
cache_credentials = True
krb5_store_password_if_offline = True
dyndns_update = {{ ad_dyndns_update | ternary('True', 'False') }}
