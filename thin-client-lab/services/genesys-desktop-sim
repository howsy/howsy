#!/bin/sh
# Stand-in for the Genesys Cloud desktop app in the simulated lab: records that
# it was started (or brought to the front) on this laptop, then stays running.
log="/tmp/genesys-desktop-$(id -un).log"
if [ "$1" = "--focus" ]; then echo "$(date +%T) focus" >> "$log"; exit 0; fi
echo "$(date +%T) started pid $$" >> "$log"
exec sleep infinity
